TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# Blank: all permitted private business chats. Positive ID: test scope. 0: discovery only.
TELEGRAM_CHAT_ID=
# Both processes must use the same directory. Blank uses data/ beside these programs.
TELEGRAM_DATA_DIR=
# Public HTTPS URL routed to the local server; leave blank to omit launch buttons.
TELEGRAM_WEBAPP_URL=
TELEGRAM_HOST=127.0.0.1
TELEGRAM_PORT=8787
