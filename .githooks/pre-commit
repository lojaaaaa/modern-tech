#!/usr/bin/env sh
set -eu
cd "$(git rev-parse --show-toplevel)"
git diff --cached --check
printf 'Checking frontend lint and production build…\n'
(cd frontend && npm run lint && npm run build)
if ! git diff --cached --quiet -- backend/; then
  printf 'Checking PHP style and static analysis…\n'
  docker compose exec -T api vendor/bin/pint --test
  docker compose exec -T api vendor/bin/phpstan analyse --memory-limit=512M --no-progress
fi
