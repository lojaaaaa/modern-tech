#!/usr/bin/env sh
set -eu
cd "$(git rev-parse --show-toplevel)"
# Never validate different bytes from those about to be committed.
if ! git diff --quiet || test -n "$(git ls-files --others --exclude-standard)"; then
  printf 'Есть неиндексированные изменения. Добавьте их в коммит или временно уберите перед проверкой.\n' >&2
  exit 1
fi
git diff --cached --check
bash scripts/check-quality.sh
